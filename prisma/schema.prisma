// ════════════════════════════════════════════════════════════════════════════
// AMANA — Schéma Prisma
// BismiLlāh ar-Rahmān ar-Rahīm
// Stack : Neon PostgreSQL + Prisma + NextAuth v5 (aligné sur FOOTUR).
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Une seule URL : la même en local et sur Vercel (injectée par l'intégration
  // Neon). Le pooler accepte le `db push` utilisé au déploiement.
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Auth (NextAuth v5) ───────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  role           Role      @default(USER)
  hashedPassword String? // connexion email + mot de passe (optionnelle)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?
  notifyEmail    Boolean   @default(true)

  accounts Account[]
  sessions Session[]
  profile  Profile?
  values   Value[]
  projects Project[]
  tasks    Task[]
  memories Memory[]
  events   Event[]
  insights Insight[]
  conversations Conversation[]
  annualGoals AnnualGoal[]
  notifications Notification[]
  deepDives DeepDiveSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@index([email])
}

enum Role {
  USER
  ADMIN
}

// ─────────────────────────── Domaine AMANA ───────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  // Une conversation peut porter sur un projet précis : c'est le lien entre
  // le chat et les univers.
  projectId String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  situation  String?
  vision     String?
  domaines   String[]
  style      String?
  motivation String?
  disc       Json?
  wpmot      Json?
  ego        Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Value {
  id         String   @id @default(cuid())
  userId     String
  label      String
  isCardinal Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ProjectStatus {
  ACTIVE
  SECONDARY
  WAITING
  IDEA
  ARCHIVED
}

model Project {
  id        String        @id @default(cuid())
  userId    String
  name      String
  status    ProjectStatus @default(ACTIVE)
  vision    String?
  objective String?
  domain    String?
  progress  Int           @default(0)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals Goal[]
  tasks Task[]
  conversations Conversation[]
  okrs  Okr[]
}

/** Une plongée : descente par niveaux, hypothèse par hypothèse. */
model DeepDiveSession {
  id        String    @id @default(cuid())
  userId    String
  niveau    Int       @default(1) // 1 faits · 2 croisements · 3 artefacts · 4 manière
  status    String    @default("en_cours") // en_cours | close
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signaux Signal[]

  @@index([userId, updatedAt])
}

enum Verdict {
  EN_ATTENTE
  VALIDE
  NUANCE
  INVALIDE
}

/** Une hypothèse soumise au jugement de la personne — jamais une conclusion. */
model Signal {
  id        String   @id @default(cuid())
  sessionId String
  niveau    Int
  hypothese String
  fondement String? // ce sur quoi elle s'appuie
  verdict   Verdict  @default(EN_ATTENTE)
  verbatim  String? // la réponse de la personne, mot pour mot
  createdAt DateTime @default(now())

  session DeepDiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, niveau])
}

/** Un signal envoyé à la personne : dans l'app, et par email si elle s'absente. */
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // "relance" | "cap_manquant" | "bilan" | "encouragement"
  title     String
  body      String
  href      String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/** Les 3 objectifs de l'année : ce qui donnera le sentiment de s'être accompli. */
model AnnualGoal {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  label     String
  why       String? // pourquoi celui-là compte
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year])
}

/** Un cap sur un trimestre pour un projet : un objectif, des résultats mesurables. */
model Okr {
  id        String   @id @default(cuid())
  projectId String
  period    String // ex. « 2026-Q3 »
  objective String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyResults KeyResult[]

  @@unique([projectId, period])
}

model KeyResult {
  id      String  @id @default(cuid())
  okrId   String
  label   String
  target  String? // ex. « 12 entretiens »
  current Int     @default(0)
  target_ Int     @default(100)
  order   Int     @default(0)

  okr    Okr           @relation(fields: [okrId], references: [id], onDelete: Cascade)
  checks WeeklyCheck[]
}

/** Le point hebdomadaire : où en est ce résultat clé cette semaine. */
model WeeklyCheck {
  id          String   @id @default(cuid())
  keyResultId String
  weekOf      DateTime // lundi de la semaine
  value       Int
  note        String?
  createdAt   DateTime @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@unique([keyResultId, weekOf])
}

enum GoalKind {
  RESULT
  PROGRESSION
  ALIGNMENT
}

model Goal {
  id        String   @id @default(cuid())
  projectId String
  kind      GoalKind
  label     String
  target    String?
  progress  Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  POSTPONED
  BLOCKED
}

enum TaskKind {
  TASK
  REMINDER
  DECISION
}

enum Priority {
  ESSENTIAL
  SECONDARY
  NORMAL
}

model Task {
  id        String     @id @default(cuid())
  userId    String
  projectId String?
  title     String
  kind      TaskKind   @default(TASK)
  status    TaskStatus @default(TODO)
  priority  Priority   @default(NORMAL)
  dueAt     DateTime?
  remindAt  DateTime?
  learning  String?
  /** Jour dont cette action est l'intention principale. Null pour les autres. */
  intentionDu DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

enum MemoryLayer {
  STABLE
  EVOLUTIVE
  LEARNING
}

model Memory {
  id         String      @id @default(cuid())
  userId     String
  layer      MemoryLayer
  content    String
  source     String?
  userEdited Boolean     @default(false)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  // Rappel sémantique : colonne embedding vector(1024) ajoutée au Sprint 2 (pgvector).

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id      String   @id @default(cuid())
  userId  String
  type    String
  payload Json?
  at      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Insight {
  id        String    @id @default(cuid())
  userId    String
  content   String
  evidence  String?
  shownAt   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
